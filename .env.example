# Stripe Keys (get from https://dashboard.stripe.com/apikeys)
PUBLIC_STRIPE_PUBLIC_KEY=pk_test_... # Replace with your Stripe publishable key
STRIPE_SECRET_KEY=sk_test_...        # Replace with your Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_...      # Replace with your webhook signing secret

# Email Service (Resend)
RESEND_API_KEY=re_...                 # Get from https://resend.com/api-keys
FROM_EMAIL=The Pilgrimage <hello@pilgrimage.love>  # Your verified sender email

# Crypto Wallets
PUBLIC_CRYPTO_WALLET_ETH=0x...       # Your Ethereum wallet address
PUBLIC_CRYPTO_WALLET_BTC=bc1...      # Your Bitcoin wallet address

# Analytics
PUBLIC_PLAUSIBLE_DOMAIN=pilgrimage.love

# Site Config
PUBLIC_SITE_URL=https://pilgrimage.love
